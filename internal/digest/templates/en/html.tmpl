{{define "sev"}}{{.}}{{end}}
{{- define "pkg"}}<li><span class="sev sev-{{.WorstSeverity}}">{{template "sev" .WorstSeverity}}</span> <strong>{{.Name}}</strong> {{.Installed}}{{if .Target}} → {{.Target}}{{end}} ({{len .OSVIDs}} {{if eq (len .OSVIDs) 1}}advisory{{else}}advisories{{end}}: {{join .OSVIDs ", "}}){{if .What}}<br><span class="what">{{.What}}</span>{{end}}</li>
{{end}}
{{- define "action"}}{{if eq . "fix"}}to be fixed{{else if eq . "defer"}}deferred{{else if eq . "ignore"}}ignored{{else}}decided{{end}}{{end}}
{{- define "body"}}<h1>{{.Title}}</h1>
{{if .SinceLabel}}<p class="since">{{.SinceLabel}}</p>
{{end}}{{if .OSVStale}}<p class="banner">{{stale}}</p>
{{end}}{{if .ShowEmpty}}<p class="since">{{empty}}</p>
{{end}}{{if .FailedScans}}<p class="banner">The last scan of {{.FailedScans}} {{if eq .FailedScans 1}}project{{else}}projects{{end}} did not finish.</p>
{{end}}{{if not .Catalog.Silent}}<p class="since">{{catalogLine}}</p>
{{if .Catalog.NewVersions}}<ul>
{{range .Catalog.NewVersions}}<li><strong>{{.Name}}</strong>: {{.From}} → {{.To}}</li>
{{end}}</ul>
{{end}}{{if or .Catalog.Failed .Catalog.Unreachable}}<p class="banner">{{previousData}}</p>
{{end}}{{end}}
{{- if or .Exploited .ExploitedDecided}}<h2 class="exploited">Exploited in the wild, fix these first</h2>
<ul>
{{range .Exploited}}<li><span class="sev sev-critical">{{if .Malicious}}malicious package{{else}}KEV{{end}}</span> <strong>{{.Package}}</strong> {{.Installed}}{{if .Target}} → {{.Target}}{{end}} ({{.OSVID}}) · {{.Project}}{{if .KEVAdded}} · on the KEV list since {{day .KEVAdded}}{{end}}{{if eq .Status "decided"}} · decided: fix{{end}}</li>
{{end}}{{if .ExploitedDecided}}<li>{{exploitedDecided}}</li>
{{end}}</ul>
{{end}}
{{- range .Projects}}<h2>{{.Name}}</h2>
<p class="counters">open: {{sum .Open}} (critical {{index .Open "critical"}}, high {{index .Open "high"}}, medium {{index .Open "medium"}}, low {{index .Open "low"}}) · decided: fix {{index .Decided "fix"}}, defer {{index .Decided "defer"}}, ignore {{index .Decided "ignore"}} · {{.DaysWithoutCritical}} {{if eq .DaysWithoutCritical 1}}day{{else}}days{{end}} without a new critical{{if eq .CriticalOpen 0}} · <strong>0 critical open</strong>{{end}}</p>
{{if eq .LastScanStatus "failed"}}<p class="banner">The last scan failed.</p>
{{else if eq .LastScanStatus "interrupted"}}<p class="banner">The last scan was interrupted.</p>
{{end}}
{{- if .New}}<h3>New</h3>
<ul>
{{range .New}}{{template "pkg" .}}{{end}}</ul>
{{end}}
{{- if .Gone}}<h3>Gone at the last scan, without proof of a fix</h3>
<ul>
{{range .Gone}}{{template "pkg" .}}{{end}}</ul>
{{end}}
{{- if .Superseded}}<h3>Decisions to review</h3>
<ul>
{{range .Superseded}}<li><strong>{{.Package}}</strong> {{.OSVID}}: was {{template "action" .PreviousAction}}, {{reason .Reason}}</li>
{{end}}</ul>
{{end}}
{{- if .FixWaiting}}<h3>{{fixWaiting (len .FixWaiting)}}</h3>
<ul>
{{range .FixWaiting}}<li><strong>{{.Package}}</strong> {{.OSVID}}{{if .Target}} → {{.Target}}{{end}}</li>
{{end}}</ul>
{{end}}
{{- if .FixHeld}}<h3>{{fixHeld (len .FixHeld)}}</h3>
<ul>
{{range .FixHeld}}<li><strong>{{.Package}}</strong> {{.OSVID}}</li>
{{end}}</ul>
{{end}}
{{- if .FixApplied}}<h3>Fixed in your code</h3>
<ul>
{{range .FixApplied}}<li>{{fixProven .}}</li>
{{end}}</ul>
{{end}}
{{- if .FixQueued}}<p class="banner">{{fixQueued .FixQueued}}</p>
{{end}}
{{- if .Due}}<h3>Due dates</h3>
<ul>
{{range .Due}}<li><strong>{{.Package}}</strong> {{.OSVID}}: deferred until {{day .DueAt}}{{if .Overdue}} <span class="sev sev-high">(overdue)</span>{{end}}</li>
{{end}}</ul>
{{end}}
{{- end}}
{{- if .Servers}}<h2>{{serversTitle}}</h2>
<ul>
{{range .Servers}}<li>{{serverLine .}}</li>
{{end}}</ul>
{{end}}
{{- if .ServerLogs}}<h2>{{serverLogsTitle}}</h2>
{{range .ServerLogs}}<h3>{{serverLogHead .}}</h3>
<ul>
{{range .Top}}<li>{{serverLogItem .}}{{if .Text}}<br><span class="what">{{.Text}}</span>{{end}}</li>
{{end}}{{range .Gaps}}<li>{{serverLogGap .}}</li>
{{end}}{{if .Skipped}}<li>{{serverLogSkipped .Skipped}}</li>
{{end}}{{if .Deviations}}<li>{{serverLogDeviations .}}</li>
{{end}}</ul>
{{end}}{{end}}
{{- if .Reading}}<h2>To read</h2>
<ul>
{{range .Reading}}<li><strong>{{.Source}}</strong>: {{.Title}}{{if .PublishedAt}} ({{day .PublishedAt}}){{end}}{{if .URL}}<br><span class="since">{{.URL}}</span>{{end}}</li>
{{end}}</ul>
{{end}}
{{- if .Word}}<p class="word">{{.Word}}</p>
{{end}}
{{- if .PageURL}}<p>Page: <a href="{{.PageURL}}">{{.PageURL}}</a></p>
{{end}}
{{- end -}}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{.Title}}</title>
<style>
body{font-family:system-ui,-apple-system,"Segoe UI",sans-serif;color:#1f2328;background:#ffffff;max-width:42em;margin:0 auto;padding:16px;line-height:1.5}
h1{font-size:1.3em}h2{font-size:1.1em;margin-top:1.5em;border-bottom:1px solid #d0d7de}h3{font-size:1em;margin-bottom:.2em}
ul{padding-left:1.2em}.what,.since,.counters{color:#57606a}.banner{background:#fff8c5;padding:.5em}.word{font-style:italic}
.sev{font-weight:bold}.sev-critical{color:#a40e26}.sev-high{color:#bc4c00}.sev-medium{color:#7d4e00}
</style>
</head>
<body>
{{template "body" .}}</body>
</html>
